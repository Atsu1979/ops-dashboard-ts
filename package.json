{
  "name": "ops-dashboard-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Ops watch board: blocked events, pending tasks, config changes and token usage from a single-operator AI automation stack. Hono API + React UI.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev:api": "node --experimental-strip-types --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --no-warnings=ExperimentalWarning dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
